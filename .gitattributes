# Deployment scripts must keep LF endings or bash on the VM will fail
# with "$'\r': command not found". Force LF on checkout everywhere.
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.cjs text eol=lf
*.md text
*.yaml text
*.yml text
*.json text
*.ts text
*.tsx text
*.js text
*.css text
*.html text
